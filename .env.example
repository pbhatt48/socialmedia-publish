# Long-lived Instagram User access token (Instagram API with Instagram Login).
# Needs the instagram_business_basic and instagram_business_content_publish permissions.
INSTAGRAM_ACCESS_TOKEN=

# Your Instagram professional account ID. Optional: resolved from the token via /me if empty.
INSTAGRAM_USER_ID=

# Folder holding pending/ and published/ post folders. Defaults to ./posts
POSTS_DIR=./posts

# Instagram downloads media from a public URL, so local files need to be reachable online.
# A local file posts/pending/my-post/photo.jpg is published as
#   $PUBLIC_MEDIA_BASE_URL/pending/my-post/photo.jpg
# Leave empty if every post uses full https:// media URLs.
PUBLIC_MEDIA_BASE_URL=

# Graph API version
INSTAGRAM_API_VERSION=v23.0
